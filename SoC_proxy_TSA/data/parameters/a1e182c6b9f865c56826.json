{
    "calliope_params": {
        "type": "cluster",
        "config_yaml_name": "model",
        "date_range": [
            2016,
            2017
        ],
        "calliope_full_log": [
            false,
            false
        ]
    },
    "soc_proxy_params": {
        "capacity_weights": {
            "solar": 1,
            "onshore_wind": 0.5,
            "offshore_wind": 0.5
        },
        "storage_process_losses": {
            "charging_efficiency": 0.6435,
            "discharging_efficiency": 0.5544
        },
        "dispatchable_techs": {
            "known_dispatchable_capacity_portion_mean_demand": 0.25
        },
        "soc_decomposition": {
            "method": "fft_lowpass",
            "time_horizon_hours": 24
        }
    },
    "tsa_params": {
        "k_periods": 200,
        "matrix_weights": {
            "renewables": 1,
            "demand": 1,
            "proxy": 1
        },
        "names_renewables": [
            "solar",
            "onshore_wind",
            "offshore_wind"
        ],
        "name_demand": [
            "demand_power"
        ],
        "soc_proxy": {
            "use_soc_proxy": true,
            "proxy_inputs_to_consider": [
                "surplus_LDES"
            ],
            "proxy_window": "None",
            "optimisation_proxy_mode": "endogenous",
            "lambda_soc": 1
        },
        "cluster_method": "hierarchical",
        "representation_method": "distributionRepresentation",
        "hours_per_period": 24,
        "soc_features": {
            "soc_charge_MWh": 1,
            "soc_discharge_MWh": 1
        },
        "extremes_spec": {},
        "soft_prune": false,
        "post_cluster_optimisation_params": {
            "objective": [
                {
                    "polarity": "minimise",
                    "target": "soc_proxy_ldes",
                    "weight": 1.0,
                    "mode": "match"
                }
            ]
        },
        "resample_to_daily_resolution": true,
        "distance_matrix_metric": "euclidean",
        "timelimit": 2000
    }
}